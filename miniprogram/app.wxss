page{background:#f5f6ef;color:#243d35;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}.page{padding:32rpx 30rpx 60rpx}.eyebrow{font-size:20rpx;color:#77897a;letter-spacing:4rpx;margin-bottom:14rpx}.title{font-size:47rpx;line-height:1.3;font-weight:700;letter-spacing:-1rpx}.muted{color:#859087;font-size:24rpx;line-height:1.7}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1}.section{font-size:31rpx;font-weight:600;margin:36rpx 0 22rpx}.card{background:white;border:1rpx solid #e5e9df;border-radius:25rpx;padding:28rpx;margin-bottom:22rpx}.hero{background:#204e41;color:#fff;border-radius:28rpx;padding:36rpx;position:relative;overflow:hidden;margin:28rpx 0}.hero .muted{color:#c5d5b8}.hero-number{font-size:72rpx;font-weight:600;margin:12rpx 0}.hero-title{font-size:23rpx;color:#d0dcb9}.badge{display:inline-block;background:#eff4e9;color:#53754b;padding:9rpx 16rpx;border-radius:12rpx;font-size:20rpx}.badge.amber{color:#8e6b31;background:#fbf0d9}.grid{display:flex;flex-wrap:wrap;gap:18rpx}.stat{width:calc(50% - 9rpx);background:#fff;border:1rpx solid #e5e9df;border-radius:22rpx;padding:25rpx}.stat .number{font-size:44rpx;font-weight:600;margin:10rpx 0}.unit{font-size:23rpx;font-weight:400;margin-left:8rpx;color:#8c968f}.quick{width:calc(50% - 9rpx);padding:25rpx;background:#e9eedf;border-radius:20rpx}.quick .label{font-weight:600;margin-bottom:8rpx}.small{font-size:22rpx}.card-title{font-weight:600;font-size:30rpx;line-height:1.5}.card .muted{margin-top:8rpx}.metric-row{display:flex;gap:32rpx;padding:25rpx 0}.metric-row .value{font-size:36rpx;font-weight:600;margin-top:7rpx}.button{border:0;border-radius:15rpx;background:#245748;color:white;font-size:26rpx;line-height:1.4;padding:22rpx;margin-top:18rpx;font-weight:500}.button::after{border:0}.button.secondary{background:#edf2e7;color:#395b42}.button.ghost{background:#fff;border:1rpx solid #dde5d7;color:#46624f}.button.danger{color:#9b573f;background:#faf0eb}.link{color:#476c50;font-size:24rpx}.notice{font-size:22rpx;line-height:1.8;background:#edf0e5;color:#697758;border-radius:16rpx;padding:20rpx;margin:22rpx 0}.empty{text-align:center;padding:60rpx 25rpx;color:#889285;font-size:25rpx}.divider{height:1rpx;background:#edf0e7;margin:24rpx 0}.record{border-bottom:1rpx solid #edf0e8;padding:22rpx 0}.record:last-child{border:0}.record-date{color:#929d91;font-size:22rpx;margin-top:8rpx}.dot{width:14rpx;height:14rpx;border-radius:50%;background:#7f9b60;margin-right:16rpx;flex-shrink:0}.field{margin:24rpx 0}.field-label{font-size:25rpx;font-weight:500;margin-bottom:13rpx}.input{width:100%;height:90rpx;border:1rpx solid #dde5d6;border-radius:14rpx;padding:20rpx 24rpx;background:#fbfcf8;font-size:27rpx;color:#243d35}.textarea{height:170rpx}.picker{line-height:50rpx}.field-help{font-size:21rpx;color:#939d8d;margin-top:10rpx;line-height:1.6}.error{padding:22rpx;background:#faeee8;color:#a55036;border-radius:12rpx;font-size:25rpx;margin:20rpx 0}.avatar{height:82rpx;width:82rpx;border-radius:22rpx;background:#e8efdd;color:#5c7951;display:flex;align-items:center;justify-content:center;font-size:34rpx}.table-row{display:flex;justify-content:space-between;padding:21rpx 0;border-bottom:1rpx solid #eef1e8;font-size:25rpx}.photo-grid{display:flex;flex-wrap:wrap;gap:16rpx}.photo{width:170rpx;height:145rpx;border-radius:14rpx}.footer{font-size:20rpx;color:#929d8d;text-align:center;margin:40rpx 0}.progress{height:10rpx;border-radius:10rpx;background:#edf0e5;overflow:hidden;margin:22rpx 0 12rpx}.progress-fill{height:100%;background:#92aa70;border-radius:10rpx}.chart{width:100%;height:400rpx}.warning{color:#907044;font-size:22rpx;line-height:1.7;margin-top:12rpx}.logo{width:100rpx;height:100rpx;border-radius:28rpx;background:#204e41;color:#d3e5a0;display:flex;align-items:center;justify-content:center;font-size:50rpx;font-weight:500;margin-bottom:28rpx}.login{padding-top:80rpx}.login .card{margin-top:35rpx}.identity{display:flex;align-items:center;gap:20rpx;padding:25rpx 0;border-bottom:1rpx solid #edf0e7}.identity:last-child{border:0}.chevron{font-size:35rpx;color:#9eac92}.logout{font-size:22rpx;color:#687e62;line-height:1.5;padding:12rpx 18rpx;border-radius:12rpx;border:1rpx solid #dce4d3}.header-actions{display:flex;gap:10rpx;align-items:center}
