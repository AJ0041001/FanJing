<view class="page"><view class="eyebrow">FIELD JOURNAL</view><view class="title">农事与采收记录</view><view class="muted" style="margin:14rpx 0 28rpx">{{gardenName}} · 按日期倒序</view><view wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击重试</view><view wx:if="{{!records.length}}" class="empty">暂无记录</view><view wx:for="{{records}}" wx:key="id" class="card"><view class="row"><text class="badge">{{item.kind}}</text><text class="muted">{{item.date}}</text></view><view class="card-title" style="margin-top:20rpx">{{item.gardenName}}</view><view style="margin:15rpx 0;line-height:1.8">{{item.label}}</view><view wx:if="{{item.kind === '采收' && item.note}}" class="muted">{{item.note}}</view><view class="photo-grid"><image wx:for="{{item.photoViews}}" wx:for-item="photo" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="preview"/></view><view wx:if="{{item.imageError}}" class="muted">{{item.imageError}}</view></view></view>
