<view class="page"><view class="eyebrow">GARDEN TO FACTORY</view><view class="row"><view class="title">鲜叶收购订单</view><view wx:if="{{user.role === 'factory'}}" class="badge" bindtap="publish">＋ 发布收购</view></view><view class="muted" style="margin:14rpx 0 30rpx">按量接单，采收上报同步更新交付进度。</view><view wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击重试</view>
  <view wx:if="{{!orders.length}}" class="empty">暂无收购订单</view>
  <view class="card" wx:for="{{orders}}" wx:key="id"><view class="row"><view class="card-title grow">{{item.title}}</view><text class="badge {{item.status === 'closed' || item.expired ? 'amber' : ''}}">{{item.status === 'closed' ? '已关闭' : item.expired ? '已截止' : item.remaining === 0 ? '已接满' : '收购中'}}</text></view><view class="muted">{{item.grade}} · 截止 {{item.deadline}}</view><view class="metric-row"><view class="grow"><view class="muted">收购单价</view><view class="value">¥ {{item.price}}<text class="unit">/ kg</text></view></view><view class="grow"><view class="muted">剩余需求</view><view class="value">{{item.remaining}}<text class="unit">kg</text></view></view></view><view class="muted">{{item.note}}</view><view class="progress"><view class="progress-fill" style="width:{{item.progress}}%"></view></view><view class="row muted"><text>已接 {{item.quantity - item.remaining}} / {{item.quantity}} kg</text><text>已报交付 {{item.delivered}} kg</text></view>
    <view wx:if="{{user.role === 'factory' && item.claims.length}}" class="notice"><view wx:for="{{item.claims}}" wx:for-item="claim" wx:key="id">{{claim.ownerName}} · {{claim.gardenName}}<view class="small">接单 {{claim.amount}} kg · 已报交付 {{claim.delivered}} kg</view></view></view>
    <view wx:if="{{user.role === 'farmer'}}"><view wx:if="{{item.mine}}" class="notice">我的接单 {{item.mine}} kg · 待交付 {{item.myPending}} kg</view><button wx:if="{{item.status === 'open' && !item.expired && item.remaining > 0}}" class="button" data-id="{{item.id}}" bindtap="accept">接取订单</button><button wx:if="{{item.myPending > 0}}" class="button secondary" data-id="{{item.id}}" bindtap="harvest">上报采收并登记交付</button></view>
    <button wx:if="{{user.role === 'factory' && item.status === 'open'}}" class="button ghost" data-id="{{item.id}}" bindtap="close">关闭接单</button>
  </view><view class="notice">交付量来自农户上报；本演示未接入付款或加工厂验收入库。</view>
</view>
